# Hicri sunucu ortam değişkenleri — bu dosyayı .env olarak kopyalayıp doldurun.
# .env ASLA depoya eklenmez (bkz. .gitignore). Değerler yalnız sunucuda kalır.

# HTTP portu (cPanel/Passenger genelde otomatik atar; boş bırakılabilir)
PORT=3000

# İstemcinin çalıştığı köken — CORS yalnız buna izin verir.
ALLOWED_ORIGIN=https://cagdasyildiz1986-gif.github.io

# JWT imzalama sırrı — uzun ve rastgele olmalı (ör. `openssl rand -hex 48`).
JWT_SECRET=degistirin-uzun-rastgele-bir-deger
# Jeton ömrü
JWT_EXPIRES=30d

# MySQL bağlantısı (cPanel MySQL Databases'ten)
DB_HOST=localhost
DB_PORT=3306
DB_USER=kullaniciadi
DB_PASSWORD=parola
DB_NAME=veritabani_adi

# Google OAuth — Google Cloud'dan alınan Web Client ID (herkese açık değer)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
